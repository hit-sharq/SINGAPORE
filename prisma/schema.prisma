model MaintenanceWindow {
  id        String @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  message   String
  active    Boolean @default(true)
}

model StoreCredit {
  id        String @id @default(cuid())
  customerId String
  amount    Decimal @db.Decimal(12, 2)
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

model LoyaltyEvent {
  id        String @id @default(cuid())
  customerId String
  points    Int
  reason    String
  createdAt DateTime @default(now())
}

model ProductBundle {
  id        String @id @default(cuid())
