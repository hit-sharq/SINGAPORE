generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  BARTENDER
  WAITER
  INVENTORY_MANAGER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  OPEN
  PAID
  VOID
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PESAPAL
  CASH
  CARD
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum NotificationType {
  ORDER
  PAYMENT
  INVENTORY
  SYSTEM
}

model StaffProfile {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  name        String
  email       String   @unique
  role        Role     @default(CASHIER)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]  @relation("createdBy")
  approved    RoleGrant[] @relation("approvedBy")
  grants      RoleGrant[] @relation("grantedTo")
  auditLogs   AuditLog[]
  notifications Notification[]
}

model RoleGrant {
  id             String @id @default(cuid())
  userId         String
  role           Role
  approvedById   String
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  user           StaffProfile @relation("grantedTo", fields: [userId], references: [id])
  approvedBy     StaffProfile @relation("approvedBy", fields: [approvedById], references: [id])
  @@unique([userId, role])
}

model Category {
  id          String @id @default(cuid())
  name        String @unique
  products    Product[]
  createdAt   DateTime @default(now())
}

model Product {
  id          String @id @default(cuid())
  name        String
  sku         String @unique
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  price       Decimal @db.Decimal(12, 2)
  costPrice   Decimal @db.Decimal(12, 2)
  stock       Decimal @default(0) @db.Decimal(12, 3)
  reorderAt   Decimal @default(0) @db.Decimal(12, 3)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  stockMoves  StockMovement[]
  @@index([categoryId, status])
}

model VenueTable {
  id        String @id @default(cuid())
  name      String @unique
  status    TableStatus @default(AVAILABLE)
  capacity  Int @default(4)
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id          String @id @default(cuid())
  number      Int @unique @default(autoincrement())
  status      OrderStatus @default(OPEN)
  total       Decimal @default(0) @db.Decimal(12, 2)
  tableId     String?
  table       VenueTable? @relation(fields: [tableId], references: [id])
  createdById String
  createdBy   StaffProfile @relation("createdBy", fields: [createdById], references: [id])
  items       OrderItem[]
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Payment {
  id              String @id @default(cuid())
  orderId         String
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal @db.Decimal(12, 2)
  currency        String @default("KES")
  pesapalOrderId  String? @unique
  merchantRef     String? @unique
  confirmationRef String?
  rawResponse     Json?
  order           Order @relation(fields: [orderId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([status, createdAt])
}

model StockMovement {
  id        String @id @default(cuid())
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  reason    String
  reference String?
  product   Product @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  user      StaffProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id        String @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  user      StaffProfile @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([entity, entityId, createdAt])
}

model AppSetting {
  key       String @id
  value     String
  updatedAt DateTime @updatedAt
}

model PesapalTransaction {
  id              String @id @default(cuid())
  orderId         String
  merchantRef     String @unique
  pesapalOrderId  String? @unique
  status          PaymentStatus @default(PENDING)
  amount          Decimal @db.Decimal(12, 2)
  currency        String @default("KES")
  callbackPayload Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([status, createdAt])
}

model Customer {
  id        String @id @default(cuid())
  name      String
  phone     String? @unique
  email     String? @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id        String @id @default(cuid())
  customerId String?
  tableId   String
  startsAt  DateTime
  endsAt    DateTime
  status    String @default("CONFIRMED")
  createdAt DateTime @default(now())
  @@index([tableId, startsAt, endsAt])
}

model Expense {
  id          String @id @default(cuid())
  description String
  amount      Decimal @db.Decimal(12, 2)
  category    String
  createdById String
  createdAt   DateTime @default(now())
  @@index([createdAt])
}

model DailySummary {
  id            String @id @default(cuid())
  day           DateTime @unique
  revenue       Decimal @default(0) @db.Decimal(12, 2)
  orderCount    Int @default(0)
  pesapalTotal  Decimal @default(0) @db.Decimal(12, 2)
  cashTotal     Decimal @default(0) @db.Decimal(12, 2)
  cardTotal     Decimal @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WebhookEvent {
  id          String @id @default(cuid())
  provider    String
  externalId  String @unique
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())
}

model IdempotencyKey {
  key       String @id
  response  Json?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model AppConfig {
  id              String @id @default(cuid())
  initialAdminId  String @unique
  venueName       String @default("Singapore Club")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CustomerOrder {
  id         String @id @default(cuid())
  customerId String
  orderId    String @unique
}

model ProductPriceHistory {
  id        String @id @default(cuid())
  productId String
  price     Decimal @db.Decimal(12, 2)
  changedBy String
  createdAt DateTime @default(now())
}

model Shift {
  id            String @id @default(cuid())
  userId        String
  startsAt      DateTime
  endsAt        DateTime?
  status        String @default("OPEN")
  openingCash   Decimal @default(0) @db.Decimal(12, 2)
  closingCash   Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  cashDrawer    CashDrawer?
  cashTransactions CashTransaction[]
}

model CashDrawer {
  id        String @id @default(cuid())
  shiftId   String @unique
  balance   Decimal @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
  shift     Shift @relation(fields: [shiftId], references: [id])
}

model InventoryCount {
  id        String @id @default(cuid())
  productId String
  countedBy String
  expected  Decimal @db.Decimal(12, 3)
  counted   Decimal @db.Decimal(12, 3)
  createdAt DateTime @default(now())
}

model Announcement {
  id        String @id @default(cuid())
  title     String
  message   String
  createdBy String
  publishedAt DateTime?
  createdAt DateTime @default(now())
}

model ReportExport {
  id        String @id @default(cuid())
  userId    String
  type      String
  status    String @default("PENDING")
  createdAt DateTime @default(now())
}

model LoginEvent {
  id        String @id @default(cuid())
  clerkUserId String
  success   Boolean
  ipAddress String?
  createdAt DateTime @default(now())
}

model SystemHealth {
  id        String @id @default(cuid())
  service   String @unique
  status    String
  checkedAt DateTime @updatedAt
}

model TaxRule {
  id        String @id @default(cuid())
  name      String @unique
  rate      Decimal @db.Decimal(5, 2)
  active    Boolean @default(true)
}

model DiscountRule {
  id        String @id @default(cuid())
  name      String @unique
  percentage Decimal @db.Decimal(5, 2)
  active    Boolean @default(true)
}

model OrderDiscount {
  id        String @id @default(cuid())
  orderId   String
  ruleId    String
  amount    Decimal @db.Decimal(12, 2)
}

model OrderTax {
  id        String @id @default(cuid())
  orderId   String
  ruleId    String
  amount    Decimal @db.Decimal(12, 2)
}

model PrinterConfig {
  id        String @id @default(cuid())
  name      String
  endpoint  String
  active    Boolean @default(true)
}

model IntegrationEvent {
  id        String @id @default(cuid())
  provider  String
  eventType String
  status    String
  payload   Json?
  createdAt DateTime @default(now())
}

model ApiKey {
  id        String @id @default(cuid())
  name      String
  hash      String @unique
  lastUsedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roleGrants  RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@unique([role, permissionId])
}

model FeatureFlag {
  key       String @id
  enabled   Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model DataRetention {
  id        String @id @default(cuid())
  entity    String @unique
  days      Int
  enabled   Boolean @default(true)
}

model SupportTicket {
  id        String @id @default(cuid())
  createdBy String
  subject   String
  message   String
  status    String @default("OPEN")
  createdAt DateTime @default(now())
}

model Attachment {
  id        String @id @default(cuid())
  entity    String
  entityId  String
  url       String
  name      String
  createdAt DateTime @default(now())
}

model SyncCursor {
  provider  String @id
  cursor    String?
  updatedAt DateTime @updatedAt
}

model EmailEvent {
  id        String @id @default(cuid())
  recipient String
  type      String
  status    String
  createdAt DateTime @default(now())
}

model HealthCheck {
  id        String @id @default(cuid())
  name      String @unique
  lastRunAt DateTime?
  status    String
  details   Json?
}

model AppSession {
  id        String @id @default(cuid())
  clerkUserId String
  lastSeenAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model LoginPolicy {
  id        String @id @default(cuid())
  requireEmailVerification Boolean @default(false)
  maxAttempts Int @default(5)
}

model Venue {
  id        String @id @default(cuid())
  name      String @unique
  timezone  String @default("Africa/Nairobi")
  currency  String @default("KES")
}

model BusinessDay {
  id        String @id @default(cuid())
  date      DateTime @unique
  openedAt  DateTime?
  closedAt  DateTime?
  closedBy  String?
}

model Reconciliation {
  id        String @id @default(cuid())
  paymentId String
  expected  Decimal @db.Decimal(12, 2)
  received  Decimal @db.Decimal(12, 2)
  status    String
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id        String @id @default(cuid())
  userId    String @unique
  orderAlerts Boolean @default(true)
  paymentAlerts Boolean @default(true)
  inventoryAlerts Boolean @default(true)
}

model ApprovalRequest {
  id        String @id @default(cuid())
  requestedBy String
  approvedBy String?
  type      String
  status    String @default("PENDING")
  payload   Json?
  createdAt DateTime @default(now())
  decidedAt DateTime?
}

model ExternalReference {
  id         String @id @default(cuid())
  entity     String
  entityId   String
  provider   String
  externalId String
  @@unique([provider, externalId])
}

model OutboxEvent {
  id          String @id @default(cuid())
  type        String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}

model ReportSnapshot {
  id        String @id @default(cuid())
  name      String
  periodStart DateTime
  periodEnd DateTime
  data      Json
  createdAt DateTime @default(now())
}

model RateLimitEvent {
  id        String @id @default(cuid())
  key       String
  action    String
  createdAt DateTime @default(now())
  @@index([key, createdAt])
}

model DataImport {
  id        String @id @default(cuid())
  type      String
  status    String @default("PENDING")
  createdBy String
  error     String?
  createdAt DateTime @default(now())
}

model DataExport {
  id        String @id @default(cuid())
  type      String
  status    String @default("PENDING")
  requestedBy String
  createdAt DateTime @default(now())
}

model WebhookDelivery {
  id        String @id @default(cuid())
  provider  String
  eventId   String
  status    String
  attempts  Int @default(0)
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  @@unique([provider, eventId])
}

model AuditRetentionPolicy {
  id        String @id @default(cuid())
  days      Int @default(365)
  updatedAt DateTime @updatedAt
}

model CurrencyRate {
  id        String @id @default(cuid())
  base      String
  quote     String
  rate      Decimal @db.Decimal(18, 8)
  asOf      DateTime
  @@unique([base, quote])
}

model Receipt {
  id        String @id @default(cuid())
  orderId   String @unique
  number    String @unique
  issuedAt  DateTime @default(now())
  url       String?
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int @default(0)
}

model CustomerNote {
  id         String @id @default(cuid())
  customerId String
  note       String
  createdBy  String
  createdAt  DateTime @default(now())
}

model StaffInvite {
  id         String @id @default(cuid())
  email      String
  role       Role
  invitedBy  String
  tokenHash  String @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
}

model RoleChange {
  id        String @id @default(cuid())
  userId    String
  fromRole  Role?
  toRole    Role
  changedBy String
  createdAt DateTime @default(now())
}

model DashboardWidget {
  id        String @id @default(cuid())
  userId    String
  widgetKey String
  position  Int
  enabled   Boolean @default(true)
  @@unique([userId, widgetKey])
}

model SavedFilter {
  id        String @id @default(cuid())
  userId    String
  name      String
  resource  String
  definition Json
  createdAt DateTime @default(now())
}

model SystemNotice {
  id        String @id @default(cuid())
  severity  String
  message   String
  active    Boolean @default(true)
  createdAt DateTime @default(now())
}

model SyncFailure {
  id        String @id @default(cuid())
  provider  String
  message   String
  resolvedAt DateTime?
  createdAt DateTime @default(now())
}

model OnboardingState {
  id        String @id @default(cuid())
  clerkUserId String @unique
  completed Boolean @default(false)
  completedAt DateTime?
}

model AppVersion {
  id        String @id @default(cuid())
  version   String @unique
  releasedAt DateTime @default(now())
}

model JobRun {
  id        String @id @default(cuid())
  job       String
  status    String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  error     String?
}

model ApiRequestLog {
  id         String @id @default(cuid())
  method     String
  path       String
  statusCode Int
  clerkUserId String?
  durationMs Int?
  createdAt  DateTime @default(now())
  @@index([path, createdAt])
}

model BackupRecord {
  id        String @id @default(cuid())
  provider  String
  status    String
  location  String?
  createdAt DateTime @default(now())
}

model ConsentRecord {
  id        String @id @default(cuid())
  clerkUserId String
  consentType String
  version   String
  grantedAt DateTime @default(now())
}

model LegalDocument {
  id        String @id @default(cuid())
  type      String
  version   String
  contentUrl String
  publishedAt DateTime @default(now())
  @@unique([type, version])
}

model Team {
  id        String @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model TeamMember {
  id        String @id @default(cuid())
  teamId    String
  clerkUserId String
  role      Role
  @@unique([teamId, clerkUserId])
}

model ApiHealthMetric {
  id        String @id @default(cuid())
  service   String
  latencyMs Int
  success   Boolean
  createdAt DateTime @default(now())
}

model DataCorrection {
  id        String @id @default(cuid())
  entity    String
  entityId  String
  reason    String
  correctedBy String
  createdAt DateTime @default(now())
}

model QueueMessage {
  id        String @id @default(cuid())
  topic     String
  payload   Json
  status    String @default("PENDING")
  attempts  Int @default(0)
  createdAt DateTime @default(now())
}

model SearchIndexState {
  id        String @id @default(cuid())
  resource  String @unique
  version   Int @default(1)
  updatedAt DateTime @updatedAt
}

model DataVersion {
  id        String @id @default(cuid())
  entity    String
  entityId  String
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())
  @@unique([entity, entityId, version])
}

model FeatureUsage {
  id        String @id @default(cuid())
  feature   String
  clerkUserId String?
  createdAt DateTime @default(now())
}

model SessionDevice {
  id        String @id @default(cuid())
  clerkUserId String
  fingerprint String
  lastSeenAt DateTime @updatedAt
  @@unique([clerkUserId, fingerprint])
}

model EmailVerification {
  id        String @id @default(cuid())
  clerkUserId String
  verifiedAt DateTime?
}

model PasswordResetAudit {
  id        String @id @default(cuid())
  clerkUserId String?
  requestedAt DateTime @default(now())
  completedAt DateTime?
}

model AdminBootstrap {
  id        String @id @default(cuid())
  clerkUserId String @unique
  configuredAt DateTime @default(now())
  configuredBy String?
}

model RolePermissionOverride {
  id        String @id @default(cuid())
  userId    String
  permissionId String
  allowed   Boolean
  @@unique([userId, permissionId])
}

model DataAccessLog {
  id        String @id @default(cuid())
  clerkUserId String?
  resource  String
  action    String
  createdAt DateTime @default(now())
}

model IntegrationCredential {
  id        String @id @default(cuid())
  provider  String @unique
  configured Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model MigrationRecord {
  id        String @id @default(cuid())
