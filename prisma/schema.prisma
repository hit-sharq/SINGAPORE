  resource  String
  createdAt DateTime @default(now())
}

model ImportRowError {
  id        String @id @default(cuid())
  importId  String
  rowNumber Int
  message   String
}

model ExportRow {
  id        String @id @default(cuid())
  exportId  String
  rowNumber Int
  payload   Json
}

model DocumentSequence {
  name      String @id
  nextValue Int @default(1)
}

model NumberSequence {
  name      String @id
  nextValue Int @default(1)
}

model UserPreference {
  id        String @id @default(cuid())
  clerkUserId String @unique
  timezone  String @default("Africa/Nairobi")
  currency  String @default("KES")
  locale    String @default("en-KE")
}

model SecurityEvent {
  id        String @id @default(cuid())
  clerkUserId String?
  type      String
  details   Json?
  createdAt DateTime @default(now())
}

model IntegrationHealth {
  id        String @id @default(cuid())
  provider  String @unique
  status    String
  checkedAt DateTime @updatedAt
  details   Json?
}

model PaymentReceipt {
  id        String @id @default(cuid())
  paymentId String @unique
  receiptUrl String?
  emailedAt DateTime?
}

model MobileMoneyAccount {
  id        String @id @default(cuid())
  provider  String
  accountName String
  accountNumber String
  active    Boolean @default(true)
}

model ReorderRequest {
  id        String @id @default(cuid())
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  status    String @default("PENDING")
  requestedBy String
  approvedBy String?
  createdAt DateTime @default(now())
}

model Supplier {
  id        String @id @default(cuid())
  name      String @unique
  phone     String?
  email     String?
  active    Boolean @default(true)
}

model PurchaseOrder {
  id        String @id @default(cuid())
